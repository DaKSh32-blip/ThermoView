<Window x:Class="ThermoView.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThermoView" Height="720" Width="1180"
        Background="#1E1E1E">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: board ================= -->
        <DockPanel Grid.Column="0">

            <!-- warning banner: green when safe, red when a chip overheats -->
            <Border DockPanel.Dock="Top" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1F6F3F" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                <Setter Property="Background" Value="#A11D1D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding WarningText}" FontSize="15" FontWeight="SemiBold" />
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" FontSize="15" Margin="0,0,0,8" />

            <!-- legend bar -->
            <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ScaleMinText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Rectangle Grid.Column="1" Height="14">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Blue"   Offset="0" />
                            <GradientStop Color="Cyan"   Offset="0.25" />
                            <GradientStop Color="Lime"   Offset="0.5" />
                            <GradientStop Color="Yellow" Offset="0.75" />
                            <GradientStop Color="Red"    Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Grid.Column="2" Text="{Binding ScaleMaxText}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <!-- The board. Inside the Viewbox everything is measured in GRID SQUARES
                 (60 wide, 40 tall). The Viewbox then scales it all up to fit the window.
                 So a chip at square (10, 12) is simply drawn at (10, 12). -->
            <Viewbox Stretch="Uniform">
                <Grid Width="{Binding BoardWidth}" Height="{Binding BoardHeight}"
                      Background="Transparent" Cursor="Cross"
                      MouseLeftButtonDown="Board_LeftClick"
                      MouseRightButtonDown="Board_RightClick">

                    <!-- layer 1: the heat map picture -->
                    <Image Source="{Binding HeatMap}" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- layer 2: chip outlines drawn on top -->
                    <ItemsControl ItemsSource="{Binding ChipItems}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}" Height="{Binding Height}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="White" />
                                            <Setter Property="BorderThickness" Value="0.25" />
                                            <Style.Triggers>
                                                <!-- overheating chips get a thick magenta outline -->
                                                <DataTrigger Binding="{Binding IsOverheating}" Value="True">
                                                    <Setter Property="BorderBrush" Value="Magenta" />
                                                    <Setter Property="BorderThickness" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Viewbox>
        </DockPanel>

        <!-- ================= RIGHT: controls ================= -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,0,4,0">
                <TextBlock Text="Simulation" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                <Button Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}" />
                <Button Content="Reset temperatures" Command="{Binding ResetCommand}" />

                <TextBlock Text="Board material" Margin="0,14,0,4" />
                <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}"
                          DisplayMemberPath="Name" FontSize="14" />

                <TextBlock Margin="0,14,0,4">
                    <Run Text="Fan strength: " />
                    <Run Text="{Binding FanStrength, StringFormat=F0, Mode=OneWay}" />
                    <Run Text=" W/m²·K" />
                </TextBlock>
                <Slider Minimum="5" Maximum="150" Value="{Binding FanStrength}" />
                <TextBlock Text="5 = still air,  150 = strong fan" FontSize="11" Foreground="#AAAAAA" />

                <TextBlock Margin="0,14,0,4">
                    <Run Text="Speed: " />
                    <Run Text="{Binding SimSpeed, StringFormat=F0, Mode=OneWay}" />
                    <Run Text="x real time" />
                </TextBlock>
                <Slider Minimum="10" Maximum="1000" Value="{Binding SimSpeed}" />
                <TextBlock Text="{Binding SpeedNote}" FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" />

                <TextBlock Text="Design the board" FontSize="18" FontWeight="Bold" Margin="0,22,0,8" />
                <ComboBox ItemsSource="{Binding ChipPresets}" SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Label" FontSize="14" />
                <TextBlock Text="Left-click the board to place a chip. Right-click a chip to remove it."
                           FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding PlacementNote}" FontSize="12" Foreground="#FFB347"
                           TextWrapping="Wrap" Margin="0,4,0,8" />
                <Button Content="Clear all chips" Command="{Binding ClearChipsCommand}" />
                <Button Content="Load demo board" Command="{Binding LoadDemoCommand}" />

                <TextBlock Text="Chips" FontSize="18" FontWeight="Bold" Margin="0,18,0,6" />
                <ItemsControl ItemsSource="{Binding ChipItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Summary}" Margin="0,3" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverheating}" Value="True">
                                                <Setter Property="Foreground" Value="#FF6B6B" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
