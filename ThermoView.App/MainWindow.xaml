<Window x:Class="ThermoView.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThermoView" Height="620" Width="1080"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- default look for text and buttons in this window -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <!-- two columns: heat map on the left, controls on the right -->
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: status, heat map, color legend -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}"
                       FontSize="16" Margin="0,0,0,10" />

            <!-- legend bar: shows which color means which temperature -->
            <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ScaleMinText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Rectangle Grid.Column="1" Height="14">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Blue"   Offset="0" />
                            <GradientStop Color="Cyan"   Offset="0.25" />
                            <GradientStop Color="Lime"   Offset="0.5" />
                            <GradientStop Color="Yellow" Offset="0.75" />
                            <GradientStop Color="Red"    Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Grid.Column="2" Text="{Binding ScaleMaxText}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <Image Source="{Binding HeatMap}" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </DockPanel>

        <!-- RIGHT: the control panel -->
        <StackPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock Text="Simulation" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
            <Button Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}" />
            <Button Content="Reset" Command="{Binding ResetCommand}" />

            <TextBlock Text="Board material" Margin="0,18,0,4" />
            <ComboBox ItemsSource="{Binding Materials}"
                      SelectedItem="{Binding SelectedMaterial}"
                      DisplayMemberPath="Name" FontSize="14" />

            <TextBlock Margin="0,18,0,4">
                <Run Text="Fan strength: " />
                <Run Text="{Binding FanStrength, StringFormat=F0, Mode=OneWay}" />
                <Run Text=" W/m²·K" />
            </TextBlock>
            <Slider Minimum="5" Maximum="150" Value="{Binding FanStrength}" />
            <TextBlock Text="5 = still air,  150 = strong fan" FontSize="11" Foreground="#AAAAAA" />

            <TextBlock Margin="0,18,0,4">
                <Run Text="Speed: " />
                <Run Text="{Binding SimSpeed, StringFormat=F0, Mode=OneWay}" />
                <Run Text="x real time" />
            </TextBlock>
            <Slider Minimum="10" Maximum="1000" Value="{Binding SimSpeed}" />
            <TextBlock Text="{Binding SpeedNote}" FontSize="11" Foreground="#AAAAAA"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</Window>
